# SafeLens Backend Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Privacy Hashing Pepper (HMAC-SHA-256)
HASH_PEPPER=safelens_local_pepper_secret_9981

# Google Safe Browsing API Key (Optional - checks URLs against Google phishing lists)
# Get one free at: https://console.cloud.google.com/apis/credentials (Enable Safe Browsing API v4)
SAFE_BROWSING_API_KEY=

# VirusTotal API Key (Optional - comprehensive URL reputation)
# Get one free at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# LLM API Key for Natural Language Explanation (Optional - Gemini or OpenAI key)
# Get one free at: https://aistudio.google.com/app/apikey
LLM_API_KEY=
